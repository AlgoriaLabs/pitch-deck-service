# Local development. Copy to .env. In production Terraform writes this file for you.
# Public values and API keys only. Never a Stellar secret key (S...).
# Comments go on their own lines: values must not have trailing comments.

# ─── THE SWITCH: testnet | mainnet ───
STELLAR_NETWORK=testnet

PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
PRICE_USDC=0.10

# ─── Testnet ───
# PAY_TO: your wallet's public address. `npm run wallet` sets it up and prints it.
PAY_TO_TESTNET=
# AGENT_ID: printed by `npm run register` (leave empty until then)
AGENT_ID_TESTNET=
# Default facilitator: https://x402.org/facilitator
# FACILITATOR_URL_TESTNET=

# ─── Mainnet ───
PAY_TO_MAINNET=
AGENT_ID_MAINNET=
# Optional: default https://mainnet.sorobanrpc.com (public). Your own provider gives more headroom.
SOROBAN_RPC_URL_MAINNET=
# Required on mainnet: key from https://channels.openzeppelin.com/gen
FACILITATOR_API_KEY_MAINNET=
# Default: https://channels.openzeppelin.com/x402
# FACILITATOR_URL_MAINNET=

# ─── LLMs: free tiers, tried in this order. Set at least one. ───
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model overrides (defaults shown):
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=qwen/qwen3-coder:free
# No LLM at all, canned text (layout work, tests):
# LLM_MOCK=1

# ─── GitHub token (optional, recommended): lifts 60 → 5,000 requests/hour ───
GITHUB_TOKEN=

# DATA_DIR=./data
# RETENTION_SECONDS=86400
# MAX_REPO_MB=40
