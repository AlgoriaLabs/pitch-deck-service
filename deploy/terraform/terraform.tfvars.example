# Copy to terraform.tfvars (git-ignored) and fill in. Lines marked ★ are required.

# ─── Oracle Cloud ───
region           = "eu-frankfurt-1"                # ★ the region= line in ~/.oci/config
compartment_ocid = "ocid1.tenancy.oc1..aaaa..."    # ★ the tenancy= line in ~/.oci/config
# availability_domain_index = 1                   # try 1 or 2 on "Out of host capacity"
# ssh_allowed_cidr = "203.0.113.7/32"              # your IP only; leave unset with CI/CD (step 7)

# ─── Address ───
acme_email = "you@example.com"                     # ★
# domain   = "deck.example.com"                    # recommended for mainnet; empty = <ip>.sslip.io

# ─── THE SWITCH ───
stellar_network = "testnet"                        # ★ testnet | mainnet
price_usdc      = "0.10"

# ─── Testnet ───
pay_to_testnet   = "G..."                          # ★ your wallet: `npm run wallet` prints it
agent_id_testnet = ""                              # `npm run register` fills this in

# ─── Mainnet (fill before switching) ───
pay_to_mainnet              = ""                   # your wallet (the testnet address is fine)
agent_id_mainnet            = ""                   # `npm run register` fills this in
facilitator_api_key_mainnet = ""                   # channels.openzeppelin.com/gen
# soroban_rpc_url_mainnet   = ""                   # optional; default https://mainnet.sorobanrpc.com

# ─── LLMs (at least one) + GitHub ───
gemini_api_key     = ""                            # ★ aistudio.google.com → Get API key
groq_api_key       = ""                            # console.groq.com (fallback)
openrouter_api_key = ""                            # openrouter.ai (fallback)
github_token       = ""                            # github.com/settings/personal-access-tokens, no scopes
