{
  "name": "pitch-deck-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Paid AI agent service on Stellar: give it a GitHub repository, get back a PPTX pitch deck. Provider Standard v1, x402 USDC.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --disable-warning=ExperimentalWarning 'dist-test/test/**/*.test.js'",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "deck": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/cli/deck.js",
    "kit": "node scripts/kit.mjs kit",
    "wallet": "node scripts/kit.mjs wallet",
    "check": "node scripts/kit.mjs check",
    "try": "node scripts/kit.mjs try",
    "register": "node scripts/kit.mjs register",
    "verify": "node scripts/kit.mjs verify",
    "update-kit": "bash scripts/update-kit.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@stellar-agent-services/payment-client": "file:vendor/stellar-agent-services-payment-client-0.0.0.tgz",
    "@stellar-agent-services/protocol": "file:vendor/stellar-agent-services-protocol-0.0.0.tgz",
    "@stellar-agent-services/provider-kit": "file:vendor/stellar-agent-services-provider-kit-0.0.0.tgz",
    "ajv": "8.20.0",
    "hono": "4.13.14",
    "pptxgenjs": "4.0.1",
    "tar": "7.5.22"
  },
  "overrides": {
    "@stellar/stellar-sdk": "16.3.1",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.3.1",
    "@types/node": "22.20.5",
    "@x402/core": "2.28.0",
    "typescript": "6.0.3"
  }
}
